# Optional model provider. The initial deterministic workflow runs without a key.
MODEL_PROVIDER=mock
MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507
# Optional explicit rates for estimated dashboard cost; leave 0 until verified for your provider.
MODEL_INPUT_COST_PER_MILLION_USD=0
MODEL_OUTPUT_COST_PER_MILLION_USD=0
# Set true only after the deterministic path has passed smoke and golden tests.
LIVE_MODEL_ENABLED=false
NEBIUS_API_KEY=
FIREWORKS_API_KEY=

# API hardening. Leave false for a frictionless local demo; set true outside it.
AUTH_ENABLED=false
ANALYST_API_KEY=
OPERATIONS_API_KEY=
ALLOWED_ORIGINS=http://localhost:8501
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=16384
# Set COPILOT_API_KEY in the Streamlit process to the appropriate API key.

# Optional LangSmith observability. Keep tracing disabled until a project/key is configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=payments-scam-copilot
# Use https://apac.api.smith.langchain.com for an APAC LangSmith account.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional hosted vector store. The MVP defaults to local lexical retrieval.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=approved-policy-v1
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-8B
# Use pinecone after ingesting the fictional policy corpus; local remains the safe default.
RAG_BACKEND=local
# Hybrid search merges semantic Pinecone candidates with local lexical candidates.
HYBRID_SEARCH_ENABLED=true
# Free, locally cached cross-encoder reranks candidates to the final four citations.
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional non-authoritative preference memory.
MEM0_API_KEY=
